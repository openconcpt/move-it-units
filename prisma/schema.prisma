generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum BookingStatus {
  pending
  confirmed
  delivered
  returned
  cancelled
}

model Package {
  id         String   @id @default(cuid())
  slug       String   @unique
  name       String   @unique
  binCount   Int
  dollyCount Int
  // Consumable that ships with the bins and isn't returned — display and
  // fulfillment data only. Must never enter availability/capacity math (see
  // lib/availability.ts).
  labelCount Int
  basePrice  Int // cents
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  bookings Booking[]

  @@map("packages")
}

model Booking {
  id        String @id @default(cuid())
  bookingRef String @unique // short human-readable code, e.g. "MVU-7K2P9Q"

  packageId String
  package   Package @relation(fields: [packageId], references: [id])

  customerName  String
  customerEmail String
  customerPhone String

  deliveryAddress String
  pickupAddress   String

  deliveryDate DateTime
  pickupDate   DateTime

  status BookingStatus @default(pending)

  // Only meaningful while status = pending: past this instant, the booking
  // no longer holds inventory (see lib/availability.ts). Cleared on confirm.
  expiresAt DateTime?

  stripeCustomerId      String?
  stripeSessionId       String? @unique
  stripePaymentIntentId String?
  stripePaymentMethodId String?

  // Add-on quantities. These consume fleet capacity (see lib/availability.ts
  // and lib/addOns.ts for the per-unit multipliers) and must always flow
  // through checkAvailability — never treat these as decorative line items.
  extraBinPacks Int @default(0)
  extraDollies  Int @default(0)
  blanketPacks  Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([packageId])
  @@index([status])
  @@index([deliveryDate, pickupDate])
  @@index([expiresAt])
  @@map("bookings")
}

model InventoryConfig {
  id            Int @id @default(1)
  totalBins     Int
  totalDollies  Int
  totalBlankets Int @default(0)

  updatedAt DateTime @updatedAt

  @@map("inventory_config")
}

// Add-on catalog: pricing AND the physical bins/dollies/blankets each unit
// represents live here together, so availability math and Stripe pricing
// can never drift apart (see lib/addOns.ts for the well-known slugs).
model AddOn {
  id     String @id @default(cuid())
  slug   String @unique
  name   String

  unitPrice Int // cents, per unit/pack purchased

  binsPerUnit     Int @default(0)
  dolliesPerUnit  Int @default(0)
  blanketsPerUnit Int @default(0)

  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("add_ons")
}

// Records Stripe webhook event ids we've already handled. Stripe delivers
// webhooks at-least-once, so this is the idempotency gate: the unique
// constraint on `id` (the Stripe event id) atomically rejects duplicates.
model ProcessedEvent {
  id          String   @id
  type        String
  processedAt DateTime @default(now())

  @@map("processed_events")
}
