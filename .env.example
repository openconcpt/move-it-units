# Supabase Postgres connection strings.
# DATABASE_URL: pooled connection (via PgBouncer, port 6543) — used by the app at runtime.
# DIRECT_URL: direct connection (port 5432) — used by Prisma Migrate.
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres"

# Stripe (test mode). Get these from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."

# From `stripe listen --print-secret` when forwarding webhooks locally (see README).
# In production, use the signing secret from the webhook endpoint in the Stripe Dashboard.
STRIPE_WEBHOOK_SECRET="whsec_..."

# Base URL used to build Stripe Checkout success/cancel redirect URLs.
APP_URL="http://localhost:3000"
